---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Impact — Civic Footprint & Community Stewardship"
  description="Grassroots journalism, regional developer ecosystems, and deliberate community assembly across southern Rajasthan."
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Top Context Ribbon -->
    <section class="pb-4 mb-8 border-b border-[#1B1B18]/15">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-sans text-[#1B1B18]/70">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#C1592B]"></span>
          <span class="font-semibold uppercase tracking-wider text-[#1F3A3D]">Public Ledger • Vol. IV</span>
        </div>
        <div class="flex items-center gap-3 font-mono">
          <span>Ecosystem Stewardship</span>
          <span class="text-[#1B1B18]/20">/</span>
          <span>onerishi<span class="text-[#C1592B]">.</span>in</span>
        </div>
      </div>
    </section>

    <!-- Editorial Header -->
    <header class="mb-14 pb-8 border-b border-[#1B1B18]/15">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-baseline">
        <div class="lg:col-span-8 space-y-2">
          <span class="font-sans text-[11px] font-semibold text-[#1F3A3D] uppercase tracking-widest block">
            Ecosystem Footprint
          </span>
          <h1 class="font-serif text-[42px] sm:text-[54px] text-[#1B1B18] tracking-tight leading-none font-normal">
            Impact
          </h1>
          <p class="font-serif text-[22px] text-[#1B1B18] font-normal pt-1">
            The throughline between deliberate craft, community assembly, and real-world outcomes.
          </p>
        </div>
        <div class="lg:col-span-4 text-left lg:text-right space-y-1 font-sans text-xs">
          <span class="text-[#1B1B18]/60 uppercase tracking-wider block font-semibold">Primary Thematics</span>
          <p class="text-[#1F3A3D] font-medium text-[13px]">Grassroots Journalism • Regional Tech Commons</p>
          <span class="text-[#1B1B18]/50 block">Updated Q4 — 2024</span>
        </div>
      </div>
    </header>

    <!-- Recognition Section: Verified National Recognition -->
    <section class="mb-16">
      <div class="bg-white rounded-xl p-6 sm:p-8 border border-[#E6E1D8] shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-4 space-y-1">
            <div class="flex items-center gap-1.5 text-[#C1592B]">
              <span class="material-symbols-outlined text-[18px]">military_tech</span>
              <span class="font-sans text-[11px] uppercase tracking-wider font-semibold">National Honor</span>
            </div>
            <h2 class="font-serif text-[24px] text-[#1B1B18] font-normal">Project Veer Gatha</h2>
            <span class="font-sans text-[12px] text-[#1F3A3D] font-medium block">Ministry of Defence &amp; Ministry of Education, Govt. of India</span>
          </div>

          <div class="lg:col-span-8 bg-[#F7F4EF] p-5 rounded-lg border border-[#1B1B18]/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-2 max-w-[540px]">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 bg-[#1F3A3D] text-white px-2.5 py-0.5 rounded text-[11px] font-sans font-semibold tracking-wide">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#C1592B]"></span>
                  <span>National Winner</span>
                </span>
                <span class="text-[11px] font-mono text-[#1B1B18]/70 bg-white px-2 py-0.5 rounded border border-[#1B1B18]/10">
                  Official Award Record: Rushal Suthar
                </span>
              </div>
              <p class="font-sans text-[13px] text-[#1B1B18]/80 leading-relaxed">
                Felicitated as a national winner in <strong>Project Veer Gatha</strong>—the premier initiative by the Ministry of Defence celebrating acts of gallantry and civic valor. Awarded under official record name <strong>Rushal Suthar</strong> for narrative excellence and civic documentation honoring India’s decorated service heroes.
              </p>
              <p class="font-sans text-[11px] text-[#1B1B18]/60 italic">
                Note: Carries the public and professional name <strong>Rushal Sharma</strong> across all digital publishing, technology, and marketing engagements.
              </p>
            </div>
            <div class="shrink-0 flex items-center gap-1.5 text-[#1F3A3D] font-mono text-[11px] border-t sm:border-t-0 sm:border-l border-[#1B1B18]/15 pt-2 sm:pt-0 sm:pl-4 font-semibold">
              <span class="material-symbols-outlined text-[16px] text-[#C1592B]">verified</span>
              <span>Verified Winner</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gazette Collective Spotlight (Social Impact) -->
    <section class="mb-16 space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-[#1B1B18]/15">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-[#C1592B] font-sans text-[11px] uppercase tracking-wider font-semibold">
            <span class="material-symbols-outlined text-[16px]">newspaper</span>
            <span>Civic Media • Case Ledger</span>
          </div>
          <h2 class="font-serif text-[32px] sm:text-[36px] text-[#1B1B18] font-normal">The Gazette Collective</h2>
        </div>
        <p class="font-sans text-[15px] text-[#1B1B18]/75 max-w-[460px] leading-relaxed">
          Decentralized community journalism creating autonomous civic desks and equipping young reporters with ethical investigative fundamentals.
        </p>
      </div>

      <!-- Feature Visual & Narrative Split -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 space-y-3">
          <div class="relative overflow-hidden rounded-xl bg-[#F0EDE8] aspect-[16/10] border border-[#E6E1D8] shadow-sm">
            <img
              src="/assets/images/impact-newsroom.jpg"
              alt="Grassroots community journalism newsroom workshop in Udaipur Rajasthan"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex items-center justify-between text-[#1B1B18]/60 font-sans text-xs px-1">
            <span>Archival Record — Community Journalism Newsroom Desk</span>
            <span class="font-mono text-[#1F3A3D]">Udaipur, Rajasthan</span>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-6 flex flex-col justify-between h-full">
          <div class="space-y-4">
            <h3 class="font-serif text-[24px] text-[#1B1B18] font-normal leading-snug">
              A newsroom owned by the communities it chronicles.
            </h3>
            <p class="font-sans text-[15px] text-[#1B1B18]/80 leading-relaxed">
              Mainstream regional reporting often filters local realities through distant commercial agendas. Through Gazette Collective, we constructed distributed civic desks that train first-time student reporters and fellows to unearth verifiable frontline stories.
            </p>
            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Every participant learns open verification, long-form oral history interviews, and digital typography—turning quiet neighborhood realities into public records.
            </p>
          </div>

          <div class="bg-white rounded-lg p-5 border border-[#E6E1D8] border-l-4 border-l-[#C1592B] shadow-sm space-y-2 font-sans">
            <span class="text-[11px] font-semibold text-[#C1592B] uppercase tracking-wider block">
              Civic Footprint &amp; Model
            </span>
            <p class="text-xs text-[#1B1B18]/75 leading-relaxed">
              Autonomous civic desks sustained by independent youth fellows across non-metro towns. Dispatches remain strictly open-access, prioritizing unvarnished local accounts over algorithmic engagement metrics.
            </p>
          </div>
        </div>
      </div>

      <!-- Gazette Initiatives Triad -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <!-- Women Gazette -->
        <div class="bg-white p-6 rounded-lg border border-[#E6E1D8] shadow-sm space-y-4 flex flex-col justify-between hover:border-[#C1592B] transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-full bg-[#1F3A3D]/10 text-[#1F3A3D] flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">groups</span>
            </div>
            <div>
              <span class="font-sans text-[11px] text-[#1F3A3D] uppercase tracking-wider font-semibold block">Civic Fellowship</span>
              <h4 class="font-serif text-[20px] text-[#1B1B18] font-normal mt-0.5">Women Gazette</h4>
            </div>
            <p class="font-sans text-[13px] text-[#1B1B18]/75 leading-relaxed">
              Dedicated editorial desk providing safety training, editorial micro-grants, and uncensored platforms for women to chronicle female healthcare, craft cooperatives, and educational access in western India.
            </p>
          </div>
          <div class="pt-3 border-t border-[#1B1B18]/10 text-xs font-sans text-[#1F3A3D] font-medium">
            Quarterly Print Broadsheet
          </div>
        </div>

        <!-- Climate Gazette -->
        <div class="bg-white p-6 rounded-lg border border-[#E6E1D8] shadow-sm space-y-4 flex flex-col justify-between hover:border-[#C1592B] transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-full bg-[#C1592B]/10 text-[#C1592B] flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">water_ec</span>
            </div>
            <div>
              <span class="font-sans text-[11px] text-[#C1592B] uppercase tracking-wider font-semibold block">Ecological Memory</span>
              <h4 class="font-serif text-[20px] text-[#1B1B18] font-normal mt-0.5">Climate Gazette</h4>
            </div>
            <p class="font-sans text-[13px] text-[#1B1B18]/75 leading-relaxed">
              Focusing on the arid ecology of the Aravalli hills, tracking groundwater depletion, traditional rainwater stepwells (baoris), and pastoral land rights through maps and hyper-local data logs.
            </p>
          </div>
          <div class="pt-3 border-t border-[#1B1B18]/10 text-xs font-sans text-[#C1592B] font-medium">
            Regional Hydrology Archive
          </div>
        </div>

        <!-- Young Gazette / Junior Journalist -->
        <div class="bg-white p-6 rounded-lg border border-[#E6E1D8] shadow-sm space-y-4 flex flex-col justify-between hover:border-[#C1592B] transition-all">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-full bg-[#1B1B18]/10 text-[#1B1B18] flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">school</span>
            </div>
            <div>
              <span class="font-sans text-[11px] text-[#1B1B18]/70 uppercase tracking-wider font-semibold block">Mentorship Incubator</span>
              <h4 class="font-serif text-[20px] text-[#1B1B18] font-normal mt-0.5">Junior Journalist</h4>
            </div>
            <p class="font-sans text-[13px] text-[#1B1B18]/75 leading-relaxed">
              Practical newsroom workshops for high-schoolers and undergraduates, cultivating foundational ethics, open-source verification skills, and civic responsibility.
            </p>
          </div>
          <div class="pt-3 border-t border-[#1B1B18]/10 text-xs font-sans text-[#1B1B18]/70 font-medium">
            Cohort Training Sprints
          </div>
        </div>
      </div>
    </section>

    <!-- Collaborations & Ecosystem Building Section -->
    <section class="mb-16 pt-12 border-t border-[#1B1B18]/15 space-y-8">
      <div class="max-w-[720px] space-y-2">
        <span class="font-sans text-[11px] font-semibold text-[#1F3A3D] uppercase tracking-widest block">
          Ecosystem Architecture
        </span>
        <h2 class="font-serif text-[32px] sm:text-[36px] text-[#1B1B18] font-normal leading-tight">
          Catalyzing Regional Capital &amp; Tech Commons
        </h2>
        <p class="font-sans text-[15px] text-[#1B1B18]/75 leading-relaxed">
          Sustainable impact requires convening physical spaces where technologists, academics, and civic storytellers exchange tools without speculative hype.
        </p>
      </div>

      <!-- Two Pillars Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Pillar 01: DevFest Udaipur 2024 -->
        <div class="bg-white p-6 sm:p-8 rounded-xl border border-[#E6E1D8] shadow-sm space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-sans text-[11px] font-semibold bg-[#C1592B]/10 text-[#C1592B] px-2.5 py-1 rounded">
                Pillar 01 • Technology Summit
              </span>
              <span class="font-mono text-xs text-[#1B1B18]/60">Udaipur, Rajasthan • 2024</span>
            </div>
            <h3 class="font-serif text-[24px] text-[#1B1B18] font-normal">Google DevFest Udaipur 2024</h3>
            <div class="relative overflow-hidden rounded-lg aspect-[16/9] bg-[#F0EDE8] border border-[#E6E1D8]">
              <img
                src="/assets/images/impact-keynote.jpg"
                alt="Keynote hall at Google DevFest Udaipur with hundreds of engineers"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Convened 850+ engineers, open-source maintainers, system architects, and student innovators across southern Rajasthan. The focus centered on practical AI agents, cloud resilience, and cultivating tier-2 software autonomy.
            </p>
            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2 text-[#1B1B18] text-xs font-medium">
                <span class="material-symbols-outlined text-[#C1592B] text-[18px]">check_circle</span>
                <span>Bridged regional students directly with global open-source core teams</span>
              </div>
              <div class="flex items-center gap-2 text-[#1B1B18] text-xs font-medium">
                <span class="material-symbols-outlined text-[#C1592B] text-[18px]">check_circle</span>
                <span>Curated zero-paywall workshops on edge computing and privacy tooling</span>
              </div>
            </div>
          </div>
          <div class="pt-4 border-t border-[#1B1B18]/10 flex items-center justify-between text-xs">
            <span class="text-[#1B1B18]/60 font-sans">Role: Community Co-Organizer &amp; Curation</span>
            <a href="/work/google-devfest-udaipur-2024" class="text-[#C1592B] font-medium flex items-center gap-1 hover:underline">
              <span>View Retrospective</span>
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Pillar 02: Gazette Media Ecosystem -->
        <div class="bg-white p-6 sm:p-8 rounded-xl border border-[#E6E1D8] shadow-sm space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-sans text-[11px] font-semibold bg-[#1F3A3D]/10 text-[#1F3A3D] px-2.5 py-1 rounded">
                Pillar 02 • Civic Distribution
              </span>
              <span class="font-mono text-xs text-[#1B1B18]/60">Regional Consortia • Active</span>
            </div>
            <h3 class="font-serif text-[24px] text-[#1B1B18] font-normal">Gazette Media Ecosystem</h3>
            <div class="relative overflow-hidden rounded-lg aspect-[16/9] bg-[#F0EDE8] border border-[#E6E1D8]">
              <img
                src="/assets/images/impact-library.jpg"
                alt="Students examining independent print publications inside academic library exhibition"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Formed direct institutional alliances with regional universities, youth collectives, and cultural organizers. This structural pipeline bypasses algorithmic gatekeepers to distribute printed dispatches and digital archives directly to academic centers.
            </p>
            <div class="space-y-2 pt-2">
              <div class="flex items-center gap-2 text-[#1B1B18] text-xs font-medium">
                <span class="material-symbols-outlined text-[#1F3A3D] text-[18px]">check_circle</span>
                <span>Integrated investigative fieldwork modules into campus communications curricula</span>
              </div>
              <div class="flex items-center gap-2 text-[#1B1B18] text-xs font-medium">
                <span class="material-symbols-outlined text-[#1F3A3D] text-[18px]">check_circle</span>
                <span>Co-created community distribution nodes in non-metro public libraries</span>
              </div>
            </div>
          </div>
          <div class="pt-4 border-t border-[#1B1B18]/10 flex items-center justify-between text-xs">
            <span class="text-[#1B1B18]/60 font-sans">Partners: 6+ Regional Academies &amp; Guilds</span>
            <a href="/work/gazette-collective" class="text-[#1F3A3D] font-medium flex items-center gap-1 hover:underline">
              <span>View Case Study</span>
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing Callout -->
    <section class="pt-12 border-t border-[#1B1B18]/15 flex flex-col sm:flex-row items-center justify-between gap-6 bg-white p-8 rounded-xl border border-[#E6E1D8]">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="font-serif text-[24px] text-[#1B1B18] font-normal">Interested in co-creating civic or educational initiatives?</h3>
        <p class="font-sans text-[14px] text-[#1B1B18]/70">Let’s explore collaborative frameworks and community programs.</p>
      </div>
      <a
        href="/collaborate"
        class="inline-flex items-center gap-1.5 px-6 py-2.5 bg-[#C1592B] text-white font-sans text-[13px] font-medium rounded-lg hover:opacity-90 transition-opacity shadow-sm shrink-0"
      >
        <span>Collaborate with Me</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </section>

  </div>
</BaseLayout>
