---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Tag from '../../components/Tag.astro';
import WrittenFromExperience from '../../components/WrittenFromExperience.astro';

export async function getStaticPaths() {
  const writingEntries = await getCollection('writing');
  return writingEntries.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Get related posts
const allPosts = await getCollection('writing');
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 2);
---

<BaseLayout
  title={`${post.data.title} — Writing`}
  description={post.data.description}
  ogImage={post.data.coverImage}
  articleDate={post.data.date}
>
  <ReadingProgress />

  <article class="w-full">
    <!-- Article Header -->
    <header class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-14 pb-8">
      <div class="max-w-[720px] mx-auto">
        
        <!-- Back Link & Category Tag -->
        <div class="flex items-center justify-between gap-4 mb-6 font-sans">
          <a
            href="/writing"
            class="group inline-flex items-center gap-1.5 text-xs text-[#1F3A3D] hover:text-[#C1592B] transition-colors font-medium tracking-wide"
          >
            <span class="material-symbols-outlined text-[16px] transition-transform group-hover:-translate-x-1">arrow_back</span>
            <span>All Writing</span>
          </a>
          <Tag variant="teal">{post.data.category}</Tag>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="font-serif text-[32px] sm:text-[42px] lg:text-[48px] font-normal tracking-tight text-[#1B1B18] mb-4 leading-[1.18] text-balance">
          {post.data.title}
        </h1>

        <p class="font-sans text-[17px] text-[#1B1B18]/80 leading-relaxed mb-8">
          {post.data.description}
        </p>

        <!-- Metadata & Share Bar -->
        <div class="p-4 bg-white border border-[#E6E1D8] rounded-lg flex flex-wrap items-center justify-between gap-4 font-sans text-xs">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#C1592B]/10 text-[#C1592B] flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">edit_note</span>
            </div>
            <div>
              <div class="text-sm font-semibold text-[#1B1B18]">Rushal S.</div>
              <div class="flex items-center gap-2 text-[#1B1B18]/65 mt-0.5">
                <span>{post.data.date}</span>
                <span class="text-[#1B1B18]/30">•</span>
                <span>{post.data.readTime}</span>
                <span class="text-[#1B1B18]/30">•</span>
                <span class="text-[#C1592B] font-medium">{post.data.volume}</span>
              </div>
            </div>
          </div>

          <!-- Share actions -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="copy-link-btn"
              class="w-8 h-8 rounded border border-[#1B1B18]/15 bg-[#F7F4EF] flex items-center justify-center text-[#1B1B18]/75 hover:text-[#C1592B] hover:border-[#C1592B] transition-colors"
              aria-label="Copy permalink"
            >
              <span class="material-symbols-outlined text-[16px]">share</span>
            </button>
            <a
              href="https://twitter.com/intent/tweet"
              target="_blank"
              rel="noreferrer"
              aria-label="Share on X"
              class="w-8 h-8 rounded border border-[#1B1B18]/15 bg-[#F7F4EF] flex items-center justify-center text-[#1B1B18]/75 hover:text-[#C1592B] hover:border-[#C1592B] text-xs font-bold transition-colors"
            >
              X
            </a>
            <a
              href="https://www.linkedin.com"
              target="_blank"
              rel="noreferrer"
              aria-label="Share on LinkedIn"
              class="w-8 h-8 rounded border border-[#1B1B18]/15 bg-[#F7F4EF] flex items-center justify-center text-[#1B1B18]/75 hover:text-[#C1592B] hover:border-[#C1592B] text-xs font-bold transition-colors"
            >
              in
            </a>
          </div>
        </div>

      </div>
    </header>

    <!-- Cover Image -->
    {post.data.coverImage && (
      <div class="max-w-[1040px] mx-auto px-4 sm:px-6 lg:px-8 mb-12">
        <figure class="overflow-hidden rounded-lg border border-[#E6E1D8] bg-white shadow-sm">
          <div class="aspect-[16/9] w-full relative bg-[#F0EDE8]">
            <img
              src={post.data.coverImage}
              alt={post.data.coverImageAlt || post.data.title}
              class="w-full h-full object-cover"
            />
          </div>
          {post.data.coverCaption && (
            <figcaption class="p-3.5 bg-white border-t border-[#E6E1D8] flex items-center justify-between gap-4 font-sans text-xs text-[#1B1B18]/70">
              <span class="italic">{post.data.coverCaption}</span>
              <span class="font-mono text-[11px] uppercase tracking-wider text-[#1F3A3D] hidden sm:inline-block">
                Archival Plate § 82
              </span>
            </figcaption>
          )}
        </figure>
      </div>
    )}

    <!-- Article Prose Container (max-w-[720px]) -->
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[720px] mx-auto">
        
        {post.data.writtenFromExperience && (
          <WrittenFromExperience
            title={post.data.writtenFromExperience.title}
            note={post.data.writtenFromExperience.note}
          />
        )}

        <div class="font-sans text-[16px] text-[#1B1B18]/85 space-y-6 leading-relaxed">
          <Content />
        </div>

        <!-- Author Bio Card -->
        <div class="my-16 p-6 sm:p-8 bg-white border border-[#E6E1D8] rounded-xl flex flex-col sm:flex-row items-start gap-6 shadow-sm">
          <div class="w-16 h-16 rounded-full overflow-hidden bg-[#F0EDE8] border border-[#1B1B18]/15 shrink-0 flex items-center justify-center">
            <img
              src="/images/rushal-portrait.jpg?v=2024"
              alt="Rushal S."
              class="w-full h-full object-cover"
            />
          </div>
          <div class="space-y-2 flex-1">
            <div class="flex items-center justify-between">
              <h3 class="font-serif text-[20px] text-[#1B1B18] font-normal">Rushal S.</h3>
              <span class="font-sans text-[11px] text-[#C1592B] uppercase tracking-wider font-semibold">Author</span>
            </div>
            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Creative technologist, demand generation specialist, and founder of Gazette Collective. Writing about the convergence of technical architecture, distribution discipline, and community agency.
            </p>
            <div class="pt-2 flex items-center gap-3 text-xs text-[#1F3A3D]">
              <a href="https://github.com" target="_blank" rel="noreferrer" class="hover:text-[#C1592B] transition-colors">GitHub</a>
              <span>•</span>
              <a href="https://linkedin.com" target="_blank" rel="noreferrer" class="hover:text-[#C1592B] transition-colors">LinkedIn</a>
              <span>•</span>
              <a href="https://youtube.com" target="_blank" rel="noreferrer" class="hover:text-[#C1592B] transition-colors">YouTube</a>
            </div>
          </div>
        </div>

        <!-- Related Dispatches -->
        {relatedPosts.length > 0 && (
          <section class="pt-4 border-t border-[#1B1B18]/15">
            <div class="flex items-center justify-between mb-6 font-sans">
              <h3 class="font-serif text-[24px] text-[#1B1B18] font-normal">Related Dispatches</h3>
              <a href="/writing" class="text-xs font-semibold text-[#1F3A3D] hover:text-[#C1592B] transition-colors inline-flex items-center gap-1">
                <span>View all entries</span>
                <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {relatedPosts.map((related) => (
                <a
                  href={`/writing/${related.slug}`}
                  class="group p-5 rounded-lg border border-[#E6E1D8] bg-white hover:border-[#C1592B] transition-all flex flex-col justify-between"
                >
                  <div class="space-y-2">
                    <div class="flex items-center justify-between font-sans text-[11px] text-[#1B1B18]/65">
                      <span class="font-semibold uppercase tracking-wider text-[#1F3A3D]">{related.data.category}</span>
                      <span>{related.data.date}</span>
                    </div>
                    <h4 class="font-serif text-[17px] text-[#1B1B18] group-hover:text-[#C1592B] transition-colors leading-snug font-normal">
                      {related.data.title}
                    </h4>
                    <p class="font-sans text-xs text-[#1B1B18]/70 line-clamp-2 leading-relaxed">
                      {related.data.description}
                    </p>
                  </div>
                  <div class="pt-4 flex items-center justify-between font-sans text-xs text-[#1B1B18]/60">
                    <span>{related.data.readTime}</span>
                    <span class="material-symbols-outlined group-hover:text-[#C1592B] group-hover:translate-x-1 transition-all text-[16px]">east</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        const icon = copyBtn.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.textContent = 'check';
          setTimeout(() => {
            icon.textContent = 'share';
          }, 2000);
        }
      });
    });
  }
</script>
