---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Collaborate — Engagements & Advisory"
  description="Collaborate with Rushal Sharma on fractional advisory consulting, community media initiatives, and junior journalist mentorship."
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Top Context & Cadence Header -->
    <header class="mb-14 pb-8 border-b border-[#1B1B18]/15">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1B1B18]/5 text-[#1F3A3D] text-[11px] font-semibold tracking-wider uppercase font-sans">
            <span class="w-1.5 h-1.5 rounded-full bg-[#C1592B]"></span>
            <span>Open Engagements • 2024 / 2025</span>
          </div>
          <h1 class="font-serif text-[42px] md:text-[56px] leading-[1.1] text-[#1B1B18] font-normal tracking-tight">
            Let’s <span class="italic font-serif text-[#C1592B]">Collaborate</span>
          </h1>
          <p class="font-sans text-[18px] text-[#1B1B18]/75 leading-relaxed max-w-[720px]">
            I partner with high-conviction founders, media collectives, and community leaders who value analytical rigor and deliberate storytelling. Every engagement is rooted in craft, agency, and compounding impact.
          </p>
        </div>

        <!-- Cadence Stamp -->
        <div class="lg:col-span-4 flex flex-col justify-end lg:items-end">
          <div class="p-5 rounded-lg bg-white border border-[#E6E1D8] shadow-sm max-w-[320px] space-y-1 font-sans">
            <div class="flex items-center justify-between text-[11px] font-semibold text-[#1F3A3D] uppercase tracking-wider">
              <span>Core Cadence</span>
              <span class="material-symbols-outlined text-[16px] text-[#C1592B]">hourglass_top</span>
            </div>
            <p class="text-xs text-[#1B1B18]/75 leading-relaxed">
              Max 2 concurrent fractional advisory roles. High-density execution over diluted commitments.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- The 3 Modalities Grid -->
    <section aria-label="Modalities of Co-Creation" class="mb-16">
      <div class="flex items-center justify-between gap-4 mb-8">
        <h2 class="font-serif text-[28px] text-[#1B1B18] font-normal">Modalities of Co-Creation</h2>
        <span class="font-sans text-[11px] uppercase tracking-wider text-[#1B1B18]/60 font-semibold">Structured Options</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Modality 01: Hire Me -->
        <div class="group relative flex flex-col justify-between p-8 rounded-lg bg-white border border-[#E6E1D8] hover:border-[#C1592B] transition-all duration-300 shadow-sm hover:shadow-editorial-hover hover:-translate-y-1">
          <div class="space-y-4">
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-[#1B1B18]/5 text-[#1F3A3D] text-[11px] font-semibold uppercase tracking-widest font-sans">
                  Modality 01
                </span>
                <span class="material-symbols-outlined text-[#C1592B] text-[22px]">corporate_fare</span>
              </div>
              <h3 class="font-serif text-[26px] text-[#1B1B18] font-normal pt-1">Hire Me</h3>
              <p class="font-sans text-xs font-semibold uppercase tracking-wide text-[#C1592B]">
                Fractional Growth &amp; GTM Advisory
              </p>
            </div>

            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Partnering with growth-stage teams to build organic distribution engines, multi-channel attribution systems, and developer-centric marketing strategies without bloated agency retainers.
            </p>

            <ul class="space-y-2 pt-2 border-t border-[#1B1B18]/10 text-xs text-[#1B1B18]/80 font-sans">
              <li class="flex items-center gap-2"><span class="text-[#C1592B]">•</span> Demand generation audit &amp; strategy</li>
              <li class="flex items-center gap-2"><span class="text-[#C1592B]">•</span> Audience mechanics &amp; video packaging</li>
              <li class="flex items-center gap-2"><span class="text-[#C1592B]">•</span> Zero-bloat static web &amp; tooling architecture</li>
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-[#1B1B18]/10">
            <a
              href="/contact?type=hire"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#C1592B] text-white font-sans text-xs font-medium py-2.5 rounded-lg hover:opacity-95 transition-opacity"
            >
              <span>Discuss Advisory</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Modality 02: Media & Community Projects -->
        <div class="group relative flex flex-col justify-between p-8 rounded-lg bg-white border border-[#E6E1D8] hover:border-[#1F3A3D] transition-all duration-300 shadow-sm hover:shadow-editorial-hover hover:-translate-y-1">
          <div class="space-y-4">
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-[#1F3A3D]/10 text-[#1F3A3D] text-[11px] font-semibold uppercase tracking-widest font-sans">
                  Modality 02
                </span>
                <span class="material-symbols-outlined text-[#1F3A3D] text-[22px]">newspaper</span>
              </div>
              <h3 class="font-serif text-[26px] text-[#1B1B18] font-normal pt-1">Media &amp; Community</h3>
              <p class="font-sans text-xs font-semibold uppercase tracking-wide text-[#1F3A3D]">
                Ecosystem Building &amp; Event Operations
              </p>
            </div>

            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Leading large-scale tech conferences, multi-track developer summits, and regional publishing collectives. Bringing broadcast-grade operational rigor to grassroots communities.
            </p>

            <ul class="space-y-2 pt-2 border-t border-[#1B1B18]/10 text-xs text-[#1B1B18]/80 font-sans">
              <li class="flex items-center gap-2"><span class="text-[#1F3A3D]">•</span> Developer summit &amp; hackathon operations</li>
              <li class="flex items-center gap-2"><span class="text-[#1F3A3D]">•</span> Regional broadsheet publishing partnerships</li>
              <li class="flex items-center gap-2"><span class="text-[#1F3A3D]">•</span> Volunteer squad playbooks &amp; runbooks</li>
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-[#1B1B18]/10">
            <a
              href="/contact?type=media"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#1F3A3D] text-white font-sans text-xs font-medium py-2.5 rounded-lg hover:opacity-95 transition-opacity"
            >
              <span>Explore Initiative</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Modality 03: Junior Journalist / Mentorship -->
        <div class="group relative flex flex-col justify-between p-8 rounded-lg bg-white border border-[#E6E1D8] hover:border-[#C1592B] transition-all duration-300 shadow-sm hover:shadow-editorial-hover hover:-translate-y-1">
          <div class="space-y-4">
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-[#1B1B18]/5 text-[#1F3A3D] text-[11px] font-semibold uppercase tracking-widest font-sans">
                  Modality 03
                </span>
                <span class="material-symbols-outlined text-[#C1592B] text-[22px]">school</span>
              </div>
              <h3 class="font-serif text-[26px] text-[#1B1B18] font-normal pt-1">Junior Journalist</h3>
              <p class="font-sans text-xs font-semibold uppercase tracking-wide text-[#C1592B]">
                Mentorship &amp; Civic Education
              </p>
            </div>

            <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed">
              Workshops and newsroom apprenticeships for student writers, university students, and local chroniclers. Fostering verifiable reporting and ethical civic storytelling.
            </p>

            <ul class="space-y-2 pt-2 border-t border-[#1B1B18]/10 text-xs text-[#1B1B18]/80 font-sans">
              <li class="flex items-center gap-2"><span class="text-[#C1592B]">•</span> High-school &amp; university cohort training</li>
              <li class="flex items-center gap-2"><span class="text-[#C1592B]">•</span> Oral history archiving workshops</li>
              <li class="flex items-center gap-2"><span class="text-[#C1592B]">•</span> Digital typesetting &amp; print publishing</li>
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-[#1B1B18]/10">
            <a
              href="/contact?type=mentorship"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#C1592B] text-white font-sans text-xs font-medium py-2.5 rounded-lg hover:opacity-95 transition-opacity"
            >
              <span>Connect for Mentorship</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Studio Operating Principles & Photo Showcase -->
    <section class="mb-20 pt-12 border-t border-[#1B1B18]/15">
      <div class="bg-white rounded-xl border border-[#E6E1D8] p-6 lg:p-10 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-6 space-y-4">
            <span class="font-sans text-[11px] font-semibold text-[#1F3A3D] uppercase tracking-widest block">
              Operating Standard
            </span>
            <h3 class="font-serif text-[28px] sm:text-[32px] text-[#1B1B18] font-normal leading-snug">
              Deliberate communication, zero ambiguous scope.
            </h3>
            <p class="font-sans text-[15px] text-[#1B1B18]/80 leading-relaxed">
              Every project begins with transparent expectations, written runbooks, and measurable milestones. Whether constructing growth pipelines or curating regional technology ecosystems, craft is treated as a serious discipline.
            </p>
            <div class="flex flex-wrap items-center gap-4 pt-2 font-sans text-xs text-[#1B1B18]/80">
              <span class="flex items-center gap-1.5 font-medium">
                <span class="material-symbols-outlined text-[#C1592B] text-[18px]">verified</span>
                Fixed-Scope Clarity
              </span>
              <span class="flex items-center gap-1.5 font-medium">
                <span class="material-symbols-outlined text-[#C1592B] text-[18px]">menu_book</span>
                Literate Documentation
              </span>
              <span class="flex items-center gap-1.5 font-medium">
                <span class="material-symbols-outlined text-[#C1592B] text-[18px]">handshake</span>
                High-Agency Autonomy
              </span>
            </div>
          </div>

          <div class="lg:col-span-6 relative">
            <div class="relative w-full h-72 sm:h-80 rounded-lg overflow-hidden shadow-sm border border-[#1B1B18]/15">
              <img
                src="/assets/images/collaborate-desk.jpg"
                alt="Tactile architectural workspace desk bathed in soft natural morning light with notebooks, drafting compass, and laptop"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1B1B18]/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white flex items-center justify-between font-sans">
                <div>
                  <p class="text-[11px] uppercase tracking-wider text-white/80">Studio Ethos</p>
                  <p class="text-[14px] font-medium text-white">Crafted across print, software, and community</p>
                </div>
                <span class="material-symbols-outlined text-[20px] text-white/80">ink_pen</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
