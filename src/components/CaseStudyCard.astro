---
import Tag from './Tag.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  role: string;
  categoryTag: string;
  caseNumber: string;
  metrics?: Array<{ label: string; value: string }>;
  heroImage?: string;
  heroImageAlt?: string;
  order?: number;
}

const {
  slug,
  title,
  description,
  role,
  categoryTag,
  caseNumber,
  metrics,
  heroImage,
  heroImageAlt,
  order = 1,
} = Astro.props;

const isEven = order % 2 === 0;
---

<article class="group mb-16 bg-white rounded-lg p-6 lg:p-8 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-editorial-hover border border-[#E6E1D8] hover:border-[#C1592B]/50">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Content Column -->
    <div class={`lg:col-span-7 flex flex-col justify-between h-full space-y-4 ${isEven ? 'order-2 lg:order-1' : ''}`}>
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <Tag variant="teal">{categoryTag}</Tag>
          <span class="font-mono text-[11px] text-[#1B1B18]/60 font-semibold">{caseNumber}</span>
        </div>

        <h2 class="font-serif text-[28px] sm:text-[32px] text-[#1B1B18] group-hover:text-[#C1592B] transition-colors duration-200 tracking-tight leading-snug mb-2 font-normal">
          <a href={`/work/${slug}`} class="focus:outline-none">
            {title}
          </a>
        </h2>

        <p class="font-sans text-[13px] text-[#1F3A3D] font-medium mb-3 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px]">verified_user</span>
          <span>Role: {role}</span>
        </p>

        <p class="font-sans text-[15px] text-[#1B1B18]/80 leading-relaxed max-w-[620px] mb-6">
          {description}
        </p>

        {metrics && metrics.length > 0 && (
          <div class="grid grid-cols-3 gap-4 py-3 border-t border-b border-[#E6E1D8] max-w-[560px] mb-6">
            {metrics.map((metric) => (
              <div>
                <span class="block font-serif text-[22px] sm:text-[24px] text-[#1B1B18] font-normal">
                  {metric.value}
                </span>
                <span class="block font-sans text-[11px] text-[#1B1B18]/70 uppercase tracking-wider font-semibold">
                  {metric.label}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <div>
        <a
          href={`/work/${slug}`}
          class="inline-flex items-center gap-1.5 font-sans text-[13px] text-[#C1592B] hover:text-[#9d3e11] font-semibold transition-all group-hover:translate-x-1"
        >
          <span>Read Case Study</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </div>

    <!-- Media / Image Column -->
    <div class={`lg:col-span-5 ${isEven ? 'order-1 lg:order-2' : ''}`}>
      <div class="overflow-hidden rounded bg-[#F0EDE8] relative aspect-[4/3] border border-[#1B1B18]/10 shadow-inner">
        {heroImage ? (
          <img
            src={heroImage}
            alt={heroImageAlt || title}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025]"
          />
        ) : (
          <div class="w-full h-full flex flex-col items-center justify-center p-4 text-center">
            <span class="material-symbols-outlined text-[36px] text-[#C1592B] mb-2">article</span>
            <span class="font-sans text-xs text-[#1B1B18]/60">Case Study Archive</span>
          </div>
        )}
      </div>
    </div>

  </div>
</article>
