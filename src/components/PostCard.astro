---
import Tag from './Tag.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date: string;
  readTime: string;
  coverImage?: string;
  coverImageAlt?: string;
}

const {
  slug,
  title,
  description,
  category,
  date,
  readTime,
  coverImage,
  coverImageAlt,
} = Astro.props;
---

<article class="flex flex-col h-full bg-white rounded-lg border border-[#E6E1D8] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#C1592B] hover:shadow-editorial-hover group cursor-pointer">
  {coverImage && (
    <div class="relative w-full aspect-[16/10] bg-[#F7F4EF] rounded overflow-hidden mb-4 border border-[#1B1B18]/10 flex items-center justify-center">
      <img
        src={coverImage}
        alt={coverImageAlt || title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95"
      />
    </div>
  )}

  <div class="flex items-center gap-2 mb-3">
    <Tag variant="teal">{category}</Tag>
    <span class="text-[#1B1B18]/30 text-[10px]">•</span>
    <span class="font-sans text-[12px] text-[#1B1B18]/70">{readTime}</span>
  </div>

  <h3 class="font-serif text-[22px] text-[#1B1B18] group-hover:text-[#C1592B] transition-colors duration-200 leading-snug mb-2 font-normal">
    <a href={`/writing/${slug}`} class="focus:outline-none">
      {title}
    </a>
  </h3>

  <p class="font-sans text-[14px] text-[#1B1B18]/75 leading-relaxed line-clamp-3 mb-6 flex-1">
    {description}
  </p>

  <div class="pt-4 border-t border-[#1B1B18]/10 flex items-center justify-between text-[#1B1B18]/70 font-sans text-[12px]">
    <span>{date}</span>
    <a
      href={`/writing/${slug}`}
      class="inline-flex items-center text-[#C1592B] font-medium group-hover:underline"
    >
      Read Essay →
    </a>
  </div>
</article>
