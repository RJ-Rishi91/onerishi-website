---
const markers = [
  {
    role: 'Event Manager',
    title: 'Google DevFest Udaipur 2024',
    description: 'Spearheaded logistics & community assembly',
    icon: 'groups',
    borderColor: 'border-[#1F3A3D]/30',
    iconColor: 'text-[#1F3A3D]',
  },
  {
    role: 'Founder & Lead',
    title: 'Gazette Collective',
    description: 'Independent media & grassroots collective',
    icon: 'newspaper',
    borderColor: 'border-[#C1592B]/40',
    iconColor: 'text-[#C1592B]',
  },
  {
    role: 'Distribution Scale',
    title: '94K+ Subscribers',
    description: 'Organic audience building & retention',
    icon: 'trending_up',
    borderColor: 'border-[#1F3A3D]/30',
    iconColor: 'text-[#1F3A3D]',
  },
  {
    role: 'Technical Stack',
    title: 'Python, React, Git',
    description: 'Engineered tooling & interactive web apps',
    icon: 'code',
    borderColor: 'border-[#1B1B18]/20',
    iconColor: 'text-[#1B1B18]',
  },
];
---

<section class="w-full border-b border-[#1B1B18]/15 bg-[#F7F4EF] py-12" aria-label="Credibility Markers">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      {markers.map((item) => (
        <div class="flex items-start gap-4 p-4 rounded-lg bg-white/40 border border-[#1B1B18]/10 hover:bg-white/80 transition-colors duration-200">
          <div class={`w-10 h-10 rounded border ${item.borderColor} ${item.iconColor} flex items-center justify-center shrink-0`}>
            <span class="material-symbols-outlined text-[20px]">{item.icon}</span>
          </div>
          <div class="space-y-0.5 min-w-0">
            <span class="font-sans text-[11px] text-[#C1592B] uppercase tracking-wider block font-semibold">
              {item.role}
            </span>
            <h4 class="font-sans text-[15px] text-[#1B1B18] font-medium leading-snug">
              {item.title}
            </h4>
            <p class="font-sans text-[13px] text-[#1B1B18]/70">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
