<div class="fixed top-20 left-0 right-0 h-[2px] z-40 bg-[#1B1B18]/10 pointer-events-none">
  <div id="reading-progress-bar" class="h-full bg-[#C1592B] w-0 transition-all duration-75 ease-out"></div>
</div>

<script>
  function updateProgress() {
    const doc = document.documentElement;
    const scrollTotal = doc.scrollHeight - doc.clientHeight;
    const bar = document.getElementById('reading-progress-bar');
    if (bar && scrollTotal > 0) {
      const percent = Math.min(100, Math.max(0, (window.scrollY / scrollTotal) * 100));
      bar.style.width = percent + '%';
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  document.addEventListener('astro:page-load', updateProgress);
</script>
