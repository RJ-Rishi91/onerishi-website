---
---

<div class="bg-white p-6 sm:p-8 lg:p-10 rounded-xl border border-[#1B1B18]/10 shadow-sm">
  <div class="mb-6">
    <h2 class="font-serif text-2xl lg:text-[28px] text-[#1B1B18] tracking-tight mb-1 font-normal">
      Start an exchange
    </h2>
    <p class="font-sans text-sm text-[#1B1B18]/70">
      Drop a note below. Concrete details, clear timelines, or problem contexts are deeply appreciated.
    </p>
  </div>

  <form id="contact-form" class="space-y-6 font-sans">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="sender-name" class="font-sans text-[11px] font-semibold text-[#1B1B18] uppercase tracking-wider block">
          Your Name <span class="text-[#C1592B]">*</span>
        </label>
        <input
          type="text"
          id="sender-name"
          name="name"
          required
          placeholder="Evelyn Vance"
          class="w-full bg-[#F7F4EF]/70 border border-[#1B1B18]/15 px-4 py-2.5 rounded-lg text-sm text-[#1B1B18] placeholder:text-[#1B1B18]/40 focus:bg-white focus:outline-none focus:border-[#C1592B] focus:ring-1 focus:ring-[#C1592B] transition-all"
        />
      </div>

      <div class="space-y-1">
        <label for="sender-email" class="font-sans text-[11px] font-semibold text-[#1B1B18] uppercase tracking-wider block">
          Email Address <span class="text-[#C1592B]">*</span>
        </label>
        <input
          type="email"
          id="sender-email"
          name="email"
          required
          placeholder="evelyn@domain.org"
          class="w-full bg-[#F7F4EF]/70 border border-[#1B1B18]/15 px-4 py-2.5 rounded-lg text-sm text-[#1B1B18] placeholder:text-[#1B1B18]/40 focus:bg-white focus:outline-none focus:border-[#C1592B] focus:ring-1 focus:ring-[#C1592B] transition-all"
        />
      </div>
    </div>

    <!-- Nature of Collaboration -->
    <div class="space-y-1">
      <label class="font-sans text-[11px] font-semibold text-[#1B1B18] uppercase tracking-wider block">
        Nature of Collaboration
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
        <label class="cursor-pointer">
          <input type="radio" name="inquiry_type" value="consulting" class="peer sr-only" checked />
          <div class="p-2.5 text-center rounded-lg bg-[#F7F4EF] border border-[#1B1B18]/15 text-[#1B1B18]/75 font-sans text-xs font-medium peer-checked:bg-[#C1592B] peer-checked:text-white peer-checked:border-[#C1592B] transition-all select-none">
            Consulting
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="inquiry_type" value="speaking" class="peer sr-only" />
          <div class="p-2.5 text-center rounded-lg bg-[#F7F4EF] border border-[#1B1B18]/15 text-[#1B1B18]/75 font-sans text-xs font-medium peer-checked:bg-[#C1592B] peer-checked:text-white peer-checked:border-[#C1592B] transition-all select-none">
            Speaking
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="inquiry_type" value="media" class="peer sr-only" />
          <div class="p-2.5 text-center rounded-lg bg-[#F7F4EF] border border-[#1B1B18]/15 text-[#1B1B18]/75 font-sans text-xs font-medium peer-checked:bg-[#C1592B] peer-checked:text-white peer-checked:border-[#C1592B] transition-all select-none">
            Media
          </div>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="inquiry_type" value="general" class="peer sr-only" />
          <div class="p-2.5 text-center rounded-lg bg-[#F7F4EF] border border-[#1B1B18]/15 text-[#1B1B18]/75 font-sans text-xs font-medium peer-checked:bg-[#C1592B] peer-checked:text-white peer-checked:border-[#C1592B] transition-all select-none">
            General
          </div>
        </label>
      </div>
    </div>

    <!-- Message Textarea -->
    <div class="space-y-1">
      <div class="flex items-center justify-between">
        <label for="message" class="font-sans text-[11px] font-semibold text-[#1B1B18] uppercase tracking-wider block">
          The Idea or Challenge <span class="text-[#C1592B]">*</span>
        </label>
        <span id="char-counter" class="font-sans text-[11px] text-[#1B1B18]/50">0 / 1200</span>
      </div>
      <textarea
        id="message"
        name="message"
        required
        rows="5"
        maxlength="1200"
        placeholder="Give me a sense of the problem space, the timeline, or what sparked your outreach..."
        class="w-full bg-[#F7F4EF]/70 border border-[#1B1B18]/15 p-4 rounded-lg text-sm text-[#1B1B18] placeholder:text-[#1B1B18]/40 focus:bg-white focus:outline-none focus:border-[#C1592B] focus:ring-1 focus:ring-[#C1592B] transition-all resize-none leading-relaxed"
      ></textarea>
    </div>

    <!-- Submit Actions -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
      <button
        type="submit"
        id="submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#C1592B] text-white font-sans text-sm font-medium px-6 py-2.5 rounded-lg hover:opacity-95 transition-all active:translate-y-px shadow-sm"
      >
        <span id="btn-text">Send Message</span>
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </button>
      <div class="flex items-center gap-1 text-[#1B1B18]/70 font-sans text-xs">
        <span class="material-symbols-outlined text-[16px] text-[#1F3A3D]">verified_user</span>
        <span>Direct to personal terminal</span>
      </div>
    </div>

    <div id="form-status" class="hidden p-4 rounded-lg bg-[#F7F4EF] border border-[#1B1B18]/15 text-[#1B1B18] font-sans text-sm transition-all"></div>
  </form>
</div>

<script>
  // Handle URL param preselection e.g. ?type=hire or ?type=media or ?type=mentorship
  const urlParams = new URLSearchParams(window.location.search);
  const typeParam = urlParams.get('type');
  if (typeParam) {
    let targetVal = 'general';
    if (typeParam.includes('hire') || typeParam.includes('consult')) targetVal = 'consulting';
    else if (typeParam.includes('media')) targetVal = 'media';
    else if (typeParam.includes('speak')) targetVal = 'speaking';
    
    const radio = document.querySelector(`input[name="inquiry_type"][value="${targetVal}"]`) as HTMLInputElement;
    if (radio) radio.checked = true;
  }

  // Live character counter
  const textarea = document.getElementById('message') as HTMLTextAreaElement;
  const counter = document.getElementById('char-counter');
  if (textarea && counter) {
    textarea.addEventListener('input', () => {
      counter.textContent = `${textarea.value.length} / 1200`;
    });
  }

  // Form submission handler
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const statusBox = document.getElementById('form-status');

  if (form && submitBtn && btnText && statusBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      btnText.textContent = 'Sending…';

      setTimeout(() => {
        btnText.textContent = 'Sent';
        statusBox.classList.remove('hidden');
        statusBox.innerHTML = `
          <div class="flex items-start gap-2 text-[#1F3A3D]">
            <span class="material-symbols-outlined text-[20px] text-[#C1592B]">check_circle</span>
            <div>
              <p class="font-semibold text-[#1B1B18]">Message Dispatched</p>
              <p class="text-xs text-[#1B1B18]/70 mt-0.5">Thank you for reaching out. I typically read and reply within 24–48 hours.</p>
            </div>
          </div>
        `;
        form.reset();
        if (counter) counter.textContent = '0 / 1200';
      }, 700);
    });
  }
</script>
