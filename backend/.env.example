# Copy this to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=sqlite:///./onerishi.db
# For Postgres later: postgresql://user:password@host:5432/dbname

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Generate with: python -c "from app.auth import hash_password; print(hash_password('yourpassword'))"
ADMIN_PASSWORD_HASH=replace-with-generated-hash

# Comma-separated list, no trailing slashes
CORS_ORIGINS=https://onerishi.in,http://localhost:3000,http://localhost:4321

# Optional: GitHub Actions webhook rebuild trigger on post publish/update/delete
GITHUB_REPO=RJ-Rishi91/onerishi-website
GITHUB_TOKEN=your_github_personal_access_token_here
